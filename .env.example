# Docker - PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ticaret_merkezi
POSTGRES_PORT=5432
# Uygulama ve migration rollerinin şifreleri (docs/SECURITY.md). En az 32 karakter rastgele.
TM_APP_DB_PASSWORD=
TM_MIGRATOR_DB_PASSWORD=

# Docker - Redis
REDIS_PORT=6379

# Veritabanı
# Uygulama: en az yetkili rol. Superuser ile production'da açılmaz.
DATABASE_URL=postgresql://tm_app:<TM_APP_DB_PASSWORD>@localhost:5432/ticaret_merkezi
# Yalnızca migration (prisma migrate). Çalışan uygulamaya verilmez.
MIGRATION_DATABASE_URL=postgresql://tm_migrator:<TM_MIGRATOR_DB_PASSWORD>@localhost:5432/ticaret_merkezi

# Redis
REDIS_URL=redis://localhost:6379
# false: this instance only enqueues jobs, starts no queue worker (API-only instance)
QUEUE_WORKERS=true
# Max wait (ms) for active jobs on shutdown before workers are force-closed
QUEUE_SHUTDOWN_TIMEOUT_MS=10000

# JWT
# En az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Uygulama
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000

# HTTP güvenliği (docs/SECURITY.md)
# İzinli origin'ler, virgülle ayrılmış. Tanımsızsa FRONTEND_URL kullanılır; boş bırakılırsa CORS kapalıdır.
# Tarayıcı backend'e doğrudan erişmez (Next.js BFF), bu yüzden boş bırakın. Joker (*) yasak; production'da https zorunlu.
CORS_ORIGINS=
# Güvenilen proxy IP/CIDR listesi veya loopback/linklocal/uniquelocal. Boş = proxy'ye güvenme. true ve sayı yasak.
# Backend'in önündeki tek istemci Next.js BFF'tir: onun adresini yazın (aynı makinede: loopback).
TRUST_PROXY=loopback
# HTTP isteklerini 426 ile reddet. Production'da varsayılan ve zorunlu: true.
ENFORCE_HTTPS=false
# İstek gövdesi üst sınırı (1b–10mb).
BODY_LIMIT=100kb
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Frontend (Next.js BFF) — docs/SECURITY.md §5
# Backend adresi. Yalnızca BFF sunucusu kullanır; tarayıcıya hiç verilmez.
BACKEND_URL=http://127.0.0.1:4000
# Uygulamanın kendi origin'i. Değiştiren isteklerde Origin bununla birebir eşleşmeli (CSRF). Production'da https.
APP_ORIGIN=http://localhost:3000
# Oturum verisinin Redis'te şifrelenmesi için anahtar. En az 32 karakter rastgele.
SESSION_SECRET=
# Next.js'in önündeki güvenilen proxy'ler (load balancer). Boş = istemciye doğrudan bağlı, X-Forwarded-For yok sayılır.
BFF_TRUST_PROXY=
FRONTEND_PORT=3000
