# Docker - PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ticaret_merkezi
POSTGRES_PORT=5432

# Docker - Redis
REDIS_PORT=6379

# Veritabanı
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticaret_merkezi

# Redis
REDIS_URL=redis://localhost:6379

# JWT
# En az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Uygulama
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
