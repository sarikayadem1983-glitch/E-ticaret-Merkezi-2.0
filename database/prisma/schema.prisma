generator client {
  provider     = "prisma-client"
  output       = "../../backend/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  plan      String    @default("free")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  users            User[]
  roles            Role[]
  userRoles        UserRole[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  companies        Company[]
  userCompanyRoles UserCompanyRole[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  companyRoles  UserCompanyRole[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]
  companyRoles UserCompanyRole[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// A business (legal entity or sole trader) operated under a tenant. Never deleted, only deactivated.
model Company {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  legalName       String   @map("legal_name") @db.VarChar(250)
  /// VKN (10 digits) or TCKN (11 digits); unique within the tenant.
  taxNumber       String   @map("tax_number") @db.VarChar(11)
  taxOffice       String   @map("tax_office") @db.VarChar(100)
  addressLine     String   @map("address_line") @db.VarChar(500)
  district        String   @db.VarChar(100)
  city            String   @db.VarChar(100)
  postalCode      String?  @map("postal_code") @db.VarChar(10)
  country         String   @default("TR") @db.Char(2)
  phone           String?  @db.VarChar(30)
  email           String?  @db.VarChar(254)
  eInvoiceEnabled Boolean  @default(false) @map("e_invoice_enabled")
  eInvoiceAlias   String?  @map("e_invoice_alias") @db.VarChar(250)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles UserCompanyRole[]

  @@unique([tenantId, taxNumber])
  @@unique([tenantId, id])
  @@index([tenantId, isActive, legalName])
  @@map("companies")
}

/// Grants a user a role on one company, in addition to tenant-level roles.
model UserCompanyRole {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  role    Role    @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, companyId, roleId])
  @@index([tenantId])
  @@index([companyId])
  @@map("user_company_roles")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  TOKEN_REUSE_DETECTED

  @@map("audit_action")
}

/// Immutable. No updated_at; a DB trigger rejects UPDATE and DELETE.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  /// Not a foreign key: history must survive user deletion.
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  module      String      @db.VarChar(50)
  entityType  String      @map("entity_type") @db.VarChar(50)
  entityId    String?     @map("entity_id") @db.VarChar(100)
  before      Json?
  after       Json?
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(512)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId])
  @@map("audit_logs")
}
