generator client {
  provider     = "prisma-client"
  output       = "../../backend/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  plan      String    @default("free")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  memberships      TenantMembership[]
  invitations      Invitation[]
  roles            Role[]
  userRoles        UserRole[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  companies        Company[]
  userCompanyRoles UserCompanyRole[]
  categories       Category[]
  brands           Brand[]
  products         Product[]
  productVariants  ProductVariant[]

  @@map("tenants")
}

/// Global identity. Tenant access lives in TenantMembership.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Deprecated (phase 1): no longer read; dropped in phase 2. NULL for invited users.
  tenantId        String?   @map("tenant_id") @db.Uuid
  name            String
  /// Lowercase; globally unique.
  email           String    @unique
  passwordHash    String    @map("password_hash")
  /// Global account switch, kept in phase 2: login, refresh and JwtAuthGuard refuse inactive users.
  /// Per-tenant access is TenantMembership.status.
  isActive        Boolean   @default(true) @map("is_active")
  /// Default tenant at login. Not a foreign key.
  lastTenantId    String?   @map("last_tenant_id") @db.Uuid
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  memberships         TenantMembership[]
  acceptedInvitations Invitation[]       @relation("InvitationAcceptedBy")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  /// System role key from roles.catalog.ts; NULL for custom roles.
  /// Partial unique index (tenant_id, key) WHERE key IS NOT NULL exists in SQL only.
  key         String?
  scope       RoleScope
  isSystem    Boolean   @default(false) @map("is_system")
  /// Informational copy for system roles; permissions are resolved from the catalog by key.
  permissions String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]
  companyRoles UserCompanyRole[]
  invitations  Invitation[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@unique([tenantId, id, scope])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // SQL-only: generated column role_scope = 'tenant' and FK
  // (tenant_id, role_id, role_scope) -> roles(tenant_id, id, scope).
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// A business (legal entity or sole trader) operated under a tenant. Never deleted, only deactivated.
model Company {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  legalName       String   @map("legal_name") @db.VarChar(250)
  /// VKN (10 digits) or TCKN (11 digits); unique within the tenant.
  taxNumber       String   @map("tax_number") @db.VarChar(11)
  taxOffice       String   @map("tax_office") @db.VarChar(100)
  addressLine     String   @map("address_line") @db.VarChar(500)
  district        String   @db.VarChar(100)
  city            String   @db.VarChar(100)
  postalCode      String?  @map("postal_code") @db.VarChar(10)
  country         String   @default("TR") @db.Char(2)
  phone           String?  @db.VarChar(30)
  email           String?  @db.VarChar(254)
  eInvoiceEnabled Boolean  @default(false) @map("e_invoice_enabled")
  eInvoiceAlias   String?  @map("e_invoice_alias") @db.VarChar(250)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles UserCompanyRole[]
  products  Product[]

  @@unique([tenantId, taxNumber])
  @@unique([tenantId, id])
  @@index([tenantId, isActive, legalName])
  @@map("companies")
}

enum MembershipStatus {
  active
  inactive

  @@map("membership_status")
}

/// "expired" is derived from expires_at when read; never stored.
enum InvitationStatus {
  pending
  accepted
  revoked

  @@map("invitation_status")
}

enum RoleScope {
  tenant
  company

  @@map("role_scope")
}

/// A user's access to one tenant. Never deleted: deactivated instead.
model TenantMembership {
  tenantId      String           @map("tenant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  status        MembershipStatus @default(active)
  /// Bumped to revoke this membership's sessions immediately.
  authVersion   Int              @default(1) @map("auth_version")
  joinedAt      DateTime         @default(now()) @map("joined_at") @db.Timestamptz
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  userRoles          UserRole[]
  companyRoles       UserCompanyRole[]
  refreshTokens      RefreshToken[]
  invitationsCreated Invitation[]      @relation("InvitationInvitedBy")

  @@id([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

/// E-mail invitation to a tenant. Only the SHA-256 of the token is stored.
/// Partial unique index (tenant_id, email) WHERE status = 'pending' exists in SQL only.
model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  /// Lowercase (CHECK constraint).
  email            String
  /// Set for an Admin invitation.
  tenantRoleId     String?          @map("tenant_role_id") @db.Uuid
  /// [{ companyId, roleId }] for company-role invitations.
  companyRoles     Json             @default("[]") @map("company_roles")
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus @default(pending)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz
  lastSentAt       DateTime?        @map("last_sent_at") @db.Timestamptz
  sendAttempts     Int              @default(0) @map("send_attempts")
  /// Short error code, never the raw error.
  lastSendError    String?          @map("last_send_error") @db.VarChar(50)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantRole Role?            @relation(fields: [tenantId, tenantRoleId], references: [tenantId, id], onDelete: Restrict)
  invitedBy  TenantMembership @relation("InvitationInvitedBy", fields: [tenantId, invitedByUserId], references: [tenantId, userId], onDelete: Restrict)
  acceptedBy User?            @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("invitations")
}

/// Grants a user a role on one company, in addition to tenant-level roles.
model UserCompanyRole {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // SQL-only: generated column role_scope = 'company' and FK
  // (tenant_id, role_id, role_scope) -> roles(tenant_id, id, scope).
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  company    Company          @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, companyId, roleId])
  /// One role per company.
  @@unique([tenantId, userId, companyId])
  @@index([tenantId])
  @@index([companyId])
  @@map("user_company_roles")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  TOKEN_REUSE_DETECTED
  INVITATION_CREATED
  INVITATION_RESENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  MEMBERSHIP_CREATED
  MEMBERSHIP_DEACTIVATED
  MEMBERSHIP_ACTIVATED
  ROLE_CHANGED
  COMPANY_ACCESS_CHANGED
  TENANT_SWITCH

  @@map("audit_action")
}

/// Immutable. No updated_at; a DB trigger rejects UPDATE and DELETE.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  /// Not a foreign key: history must survive user deletion.
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  module      String      @db.VarChar(50)
  entityType  String      @map("entity_type") @db.VarChar(50)
  entityId    String?     @map("entity_id") @db.VarChar(100)
  before      Json?
  after       Json?
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(512)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId])
  @@map("audit_logs")
}

// Catalog (CAT-01). Soft delete only: tm_app has no DELETE on these tables.
// SQL-only (never declare them here; `prisma migrate dev` / `db push` are not used):
//   partial unique indexes brands_tenant_id_name_active_key, categories_tenant_id_slug_active_key;
//   CHECKs categories_no_self_parent, categories_slug_format, brands_name_trimmed,
//   product_variants_sku_not_blank, product_variants_sku_trimmed,
//   product_variants_barcode_not_blank, product_variants_barcode_trimmed.

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

/// Tenant-wide category tree (shared by every company of the tenant).
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String    @db.VarChar(150)
  /// Lowercase, hyphen-separated; unique within the tenant among non-deleted rows.
  slug      String    @db.VarChar(160)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: NoAction)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, id])
  // SQL-only: unique (tenant_id, slug) WHERE deleted_at IS NULL.
  @@index([tenantId, parentId])
  @@map("categories")
}

/// Tenant-wide brand list. Name is trimmed and unique per tenant case-insensitively among non-deleted rows.
model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(150)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, id])
  // SQL-only: unique (tenant_id, lower(btrim(name))) WHERE deleted_at IS NULL.
  @@map("brands")
}

/// A product of one company. Sellable units are its variants (at least one; enforced by the application).
model Product {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  brandId     String?       @map("brand_id") @db.Uuid
  name        String        @db.VarChar(250)
  description String?
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company          @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  category Category?        @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict)
  variants ProductVariant[]

  @@unique([tenantId, id])
  /// Target of the variant FK: a variant always belongs to its product's company.
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@map("products")
}

/// Sellable unit. SKU and barcode are trimmed, case-sensitive and unique within the tenant
/// (across companies, soft-deleted rows included: never reused, history refers to them).
model ProductVariant {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  sku       String    @db.VarChar(100)
  barcode   String?   @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [tenantId, companyId, productId], references: [tenantId, companyId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, companyId, productId])
  @@map("product_variants")
}
